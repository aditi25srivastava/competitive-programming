import sys 
def main():
    data = sys.stdin.buffer.read().split()
    idx = 0
    t = int(data[idx]); idx += 1
    out = []
    for _ in range(t):
        n = int(data[idx]); idx += 1
        pos = [0] * (n + 1)
        for i in range(1, n + 1):
            x = int(data[idx]); idx += 1
            pos[x] = i
        ok = True
        for v in range(n, 1, -2):
            if (pos[v] - pos[v - 1]) % 2 == 0:
                ok = False
        out.append("YES" if ok else "NO")
    print("\n".join(out))
main()    