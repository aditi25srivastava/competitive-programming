import sys
from collections import defaultdict
def main():
    data = sys.stdin.read().split()
    t = int(data[0]); idx = 1
    out = []
    for _ in range(t):
        n = int(data[idx]); idx += 1
        a = data[idx:idx + n]; idx += n
        a = list(map(int, a))
        m = n - 4
        v = [a[i] + a[i + 2] - a[i + 4] for i in range(m)]
        cnt = defaultdict(int)
        ans = 0
        for x in range(m):
            ans += cnt[v[x]]
            if x >= 2 and v[x - 2] == v[x]:
                ans -= 1
            if x >= 4 and v[x - 4] == v[x]:
                ans -= 1
            cnt[v[x]] += 1
        out.append(str(ans))
    print('\n'.join(out))
main()    
