import sys
def main():
    data = sys.stdin.read().split()
    t = int(data[0])
    idx = 1
    out = []
    for _ in range(t):
        n = int(data[idx]); idx += 1
        s = data[idx]; idx += 1
        st = []
        not_printed = [False] * (n + 1)
        for i,c in enumerate(s, 1):
            if c == '1':
                st.append(i)
            elif c == '2':
                if st:
                    st.pop()
                    not_printed[i] = True
        for i in st:
            not_printed[i] = True
        res = [i for i in range(1, n + 1) if not_printed[i]]    
        out.append(str(len(res)))
        out.append(' '.join(map(str, res)))
    print('\n'.join(out))
main()    