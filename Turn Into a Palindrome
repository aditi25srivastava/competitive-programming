t = int(input())
results = []
for _ in range(t):
    n, c = input().split()
    n = int(n)
    s = input()
    cost = 0
    i, j = 0, n - 1
    while i < j:
        if s[i] != s[j]:
            if s[i] == c or s[j] == c:
                cost += 1
            else:
                cost += 2
        i += 1
        j -= 1
    results.append(cost)
print('\n'.join(map(str, results)))    
         
