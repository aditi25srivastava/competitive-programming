t = int(input())
for _ in range(t):
    n = int(input())
    p = list(map(int,input().split()))
    idx = [i for i in range(n) if p[i] != i+1]
    vals = [p[i] for i in idx]
    vals.reverse()
    for k, i in enumerate(idx):
        p[i] = vals[k]
    print("YES" if p == list(range(1, n+1)) else "NO")