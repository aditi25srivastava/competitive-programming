import heapq, sys
input = sys.stdin.readline
MOD = 998244353
def solve():
    n = int(input())
    a = list(map(int, input().split()))
    if n == 1:
        print(0)
        return
    a.sort()
    fact = 1
    for x in range(1, n):
        fact = fact * x % MOD
    inv = [0]*(n+1)
    inv[1] = 1
    for x in range(2, n+1):
        inv[x] = (MOD - (MOD//x) * inv[MOD % x] % MOD) % MOD
    suffix = [0]*(n+1)    
    for x in range(n-1, -1, -1):
        suffix[x] = (suffix[x+1] + a[x]) % MOD
    ans = 0
    for i0 in range(n-1):
        i = i0 + 1
        cnt = n - i
        s = suffix[i]
        term = (s - a[i0]*cnt) % MOD
        term = term * fact % MOD * inv[n -i] % MOD
        ans = (ans + term) % MOD
    print(ans)
t = int(input())
for _ in range(t):
    solve()
    