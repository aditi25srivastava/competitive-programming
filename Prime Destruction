import sys
def main():
    data = sys.stdin.buffer.read().split()
 
    MAXN = 200001
    spf = list(range(MAXN + 1))
 
    i = 2
    while i * i <= MAXN:
        if spf[i] == i:
            for j in range(i * i, MAXN + 1, i):
                if spf[j] == j:
                    spf[j] = i
        i += 1
 
    t = int(data[0])
    idx = 1
    out = []
 
    for _ in range(t):
        n = int(data[idx])
        k = int(data[idx + 1])
        idx += 2
 
        g = [0] * (n + 1)
 
        for x in range(k + 1, n + 1):
            best = float('inf')
            y = x
 
            while y > 1:
                p = spf[y]
 
                while y % p == 0:
                    y //= p
 
                v = 1 + p * g[x // p]
 
                if v < best:
                    best = v
 
            g[x] = best
 
        ans = 0
 
        for j in range(n):
            ans += g[int(data[idx + j])]
 
        idx += n
 
        out.append(ans)
 
    print("\n".join(map(str, out)))
 
 
main()