#include <bits/stdc++.h>
using namespace std;
int main(){
    int t; scanf("%d", &t);
    while(t--){
        int n; scanf("%d",&n);
        long long sum = 0, x;
        for(int i=0;i<n;i++){ scanf("%lld",&x); sum += x; }
        if(n % 2 == 1) printf("NO\n");
        else printf(((sum % 4 == 0) ? "YES\n" : "NO\n"));
    }
}    